{
  "name": "Maintenance Dashboard Theme",
  "dataColors": [
    "#5B9BD5", 
    "#70AD47", 
    "#FFC000", 
    "#C5E0B4", 
    "#9DC3E6", 
    "#F4B084", 
    "#A6A6A6", 
    "#264478"
  ],
  "background": "#FFFFFF",
  "foreground": "#333333",
  "tableAccent": "#5B9BD5",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F0F0F0" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "visualTooltip": [
          {
            "titleFontColor": { "solid": { "color": "#FFFFFF" } },
            "valueFontColor": { "solid": { "color": "#FFFFFF" } },
            "background": { "solid": { "color": "#264478" } }
          }
        ]
      }
    }
  }
}